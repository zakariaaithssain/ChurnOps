name: KKBox_Churn_Prediction

python_env: pyproject.toml

entry_points:
  main:
    parameters:
      stage:
        type: string
        default: "train-calib"
        description: "execution stage: 'train', 'calib', 'train-calib', or 'monitor'"
      overwrite-train:
        type: flag
        default: false
      schema:
        type: string
        default: "r1"
      data-file:
        type: string
        default: ""
      save-path:
        type: string
        default: ""
      folds:
        type: int
        default: 5
      overwrite-split:
        type: flag
        default: false
      inference-data: 
        type: string
        default: ""
        description: "inference data parquet filepath to run drift and classification tests on"
    command: >
      python main.py 
      --stage {stage}
      {overwrite-train}
      --schema {schema}
      {data-file}
      {save-path}
      --folds {folds}
      {overwrite-split}
